
import requests
import json

RPC_USER = "rpcuser"
RPC_PASS = "rpcpassword"
RPC_PORT = 1979
RPC_URL = f"http://127.0.0.1:{RPC_PORT}"

HALVING_HEIGHT = 1680000
OFFSET = 30000            # recommended 20k–40k
WINDOW = 25               # number of headers stored backwards


def rpc(method, params=[]):
    payload = {
        "jsonrpc": "2.0",
        "id": "checkpoint",
        "method": method,
        "params": params
    }

    r = requests.post(
        RPC_URL,
        json=payload,
        auth=(RPC_USER, RPC_PASS)
    )

    return r.json()["result"]


checkpoint_height = HALVING_HEIGHT + OFFSET

tip_height = rpc("getblockcount")

if checkpoint_height > tip_height:
    raise Exception("Checkpoint height is higher than current chain height")

checkpoint_hash = rpc("getblockhash", [checkpoint_height])
checkpoint_header = rpc("getblockheader", [checkpoint_hash])

chainwork = int(checkpoint_header["chainwork"], 16)

headers = []

for h in range(checkpoint_height, checkpoint_height - WINDOW, -1):
    bh = rpc("getblockhash", [h])
    header_hex = rpc("getblockheader", [bh, False])
    headers.append([h, header_hex])

checkpoint = [
    checkpoint_hash,
    chainwork,
    headers
]

with open("checkpoints.json", "w") as f:
    json.dump([checkpoint], f, indent=4)

print("Checkpoint generated at height:", checkpoint_height)